{
  "mcpServers": {
    "playwright": {
      "type": "local",
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "args": [
        "--headless",
        "--browser", "chromium"
      ],
      "env": {
        "PLAYWRIGHT_MCP_BROWSER": "chromium",
        "PLAYWRIGHT_MCP_HEADLESS": "true",
        "PLAYWRIGHT_MCP_TIMEOUT_ACTION": "10000",
        "PLAYWRIGHT_MCP_TIMEOUT_NAVIGATION": "60000",
        "PLAYWRIGHT_MCP_PORT": "8931",
        "PLAYWRIGHT_MCP_HOST": "127.0.0.1",
        "PLAYWRIGHT_MCP_ISOLATED": "true",
        "PLAYWRIGHT_MCP_NO_SANDBOX": "true",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/home/solas/.cache/ms-playwright/chromium-1228/chrome-linux64/chrome"
      },
      "capabilities": ["core", "network", "storage", "testing"],
      "snapshot": {
        "mode": "full"
      },
      "outputDir": "./.omo/evidence/task-0-testing-assignment",
      "enabled": true
    }
  }
}
